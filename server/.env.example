# Clave para firmar las sesiones. Genera una con: openssl rand -hex 32
JWT_SECRET=CAMBIA_ESTA_CLAVE_LARGA

# HTTPS (necesario para WebRTC). Dejar vacío para usar HTTP.
# HTTPS_KEY=/home/admin-a/certs/server.key
# HTTPS_CERT=/home/admin-a/certs/server.crt

# Teléfono web de cada sucursal (la clave debe coincidir con pjsip.conf de esa VM)
VOIP_1_WS=wss://192.168.56.10:8089/ws
VOIP_1_USER=102
VOIP_1_PASS=CLAVE_102
VOIP_2_WS=wss://192.168.56.11:8089/ws
